          "command": "azureDevOps.prComments.createThread",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.reply",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.resolve",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.reactivate",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.edit",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.saveEdit",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.cancelEdit",
          "when": "false"
        },
        {
          "command": "azureDevOps.prComments.delete",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.rerun",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.cancel",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.retry",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.openLog",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.approve",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.reject",
          "when": "false"
        },
        {
          "command": "azureDevOps.workItems.createLocked",
          "when": "false"
        },
        {
          "command": "azureDevOps.pullRequests.createLocked",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.runLocked",
          "when": "false"
        },
        {
          "command": "azureDevOps.pullRequests.openFile",
          "when": "resourceScheme == azdo-git"
        },
        {
          "command": "azureDevOps.signOut",
          "when": "azureDevOps.signedIn"
        },
        {
          "command": "azureDevOps.updatePat",
          "when": "azureDevOps.signedIn"
        },
        {
          "command": "azureDevOps.recheckAccess",
          "when": "azureDevOps.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "Azure DevOps",
      "properties": {
        "azureDevOps.workItems.hiddenStates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Closed",
            "Done",
            "Removed",
            "Completed",
            "Cut"
          ],
          "description": "Work item states hidden from the Assigned to Me, Created by Me and Current Iteration lists."
        },
        "azureDevOps.workItems.maxResults": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of work items loaded per list."
        },
        "azureDevOps.workItems.assignNewToMe": {
          "type": "boolean",
          "default": true,
          "description": "Assign newly created work items to yourself."
        },
        "azureDevOps.workItems.createInCurrentIteration": {
          "type": "boolean",
          "default": false,
          "description": "Put newly created work items in the team's current iteration."
        },
        "azureDevOps.workItems.branchNameTemplate": {
          "type": "string",
          "default": "feature/${id}-${title}",
          "markdownDescription": "Template for **Create Branch for Work Item**. Supports `${id}`, `${title}` (slugified) and `${type}`."
        },
        "azureDevOps.pullRequests.defaultMergeStrategy": {
          "type": "string",
          "enum": [
            "squash",
            "noFastForward",
            "rebase",
            "rebaseMerge"
          ],
          "default": "squash",
          "enumDescriptions": [
            "Squash commit",
            "Merge (no fast-forward)",
            "Rebase and fast-forward",
            "Semi-linear merge"
          ],
          "description": "Merge type suggested when completing a pull request."
        },
        "azureDevOps.pullRequests.deleteSourceBranch": {
          "type": "boolean",
          "default": true,
          "description": "Suggest deleting the source branch when completing a pull request."
        },
        "azureDevOps.pullRequests.transitionWorkItems": {
          "type": "boolean",
          "default": true,
          "description": "Suggest completing linked work items when completing a pull request."
        },
        "azureDevOps.pipelines.refreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "How often running pipelines refresh in the Pipelines view (0 disables auto-refresh)."
        },
        "azureDevOps.pipelines.showLogTimestamps": {
          "type": "boolean",
          "default": false,
          "description": "Show the timestamp at the start of every pipeline log line."
        },
        "azureDevOps.repos.cloneProtocol": {
          "type": "string",
          "enum": [
            "https",
            "ssh"
          ],
          "default": "https",
          "description": "Remote URL used by Clone Repository."
        },
        "azureDevOps.server.apiVersion": {
          "type": "string",
          "default": "7.0",
          "markdownDescription": "REST API version used with **Azure DevOps Server** (on-premises). Use `6.0` for Azure DevOps Server 2020. Azure DevOps Services always uses 7.1."
        }
      }
    },
    "languages": [
      {
        "id": "azure-pipelines-log",
        "aliases": [
          "Azure Pipelines Log"
        ]
      }
    ],
    "grammars": [
      {
        "language": "azure-pipelines-log",
        "scopeName": "text.log.azure-pipelines",
        "path": "./syntaxes/azure-pipelines-log.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
