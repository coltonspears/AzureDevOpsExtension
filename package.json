{
  "name": "azure-devops-for-cursor",
  "displayName": "Azure DevOps for Cursor",
  "description": "Work items, pull request reviews, pipelines and live logs from Azure DevOps — signed in with a PAT whose scopes are verified and shown up front.",
  "version": "0.1.0",
  "publisher": "coltonspears",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/coltonspears/AzureDevOpsExtension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "azure devops",
    "ado",
    "work items",
    "pull requests",
    "pipelines",
    "boards",
    "repos",
    "pat",
    "cursor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azureDevOps",
          "title": "Azure DevOps",
          "icon": "resources/azure-devops.svg"
        }
      ]
    },
    "views": {
      "azureDevOps": [
        {
          "id": "azureDevOps.account",
          "name": "Account & Access",
          "icon": "resources/azure-devops.svg"
        },
        {
          "id": "azureDevOps.workItems",
          "name": "Work Items"
        },
        {
          "id": "azureDevOps.pullRequests",
          "name": "Pull Requests"
        },
        {
          "id": "azureDevOps.pipelines",
          "name": "Pipelines"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "azureDevOps.account",
        "when": "!azureDevOps.signedIn",
        "contents": "Connect to Azure DevOps with a Personal Access Token (PAT) to work with Boards, Repos and Pipelines without leaving the editor.\n[Sign In with PAT](command:azureDevOps.signIn)\nAfter you sign in, the extension verifies which scopes your token grants and shows exactly which features are available. The token is stored in your operating system's keychain.\n[How to create a PAT](https://learn.microsoft.com/azure/devops/organizations/accounts/use-personal-access-tokens-to-authenticate)"
      },
      {
        "view": "azureDevOps.workItems",
        "when": "!azureDevOps.signedIn",
        "contents": "Sign in to see the work items assigned to you, your sprint, and saved queries.\n[Sign In](command:azureDevOps.signIn)"
      },
      {
        "view": "azureDevOps.pullRequests",
        "when": "!azureDevOps.signedIn",
        "contents": "Sign in to review and create pull requests.\n[Sign In](command:azureDevOps.signIn)"
      },
      {
        "view": "azureDevOps.pipelines",
        "when": "!azureDevOps.signedIn",
        "contents": "Sign in to watch pipeline runs and read their logs.\n[Sign In](command:azureDevOps.signIn)"
      },
      {
        "view": "azureDevOps.workItems",
        "when": "azureDevOps.signedIn && !azureDevOps.hasProject",
        "contents": "Choose the project to work in.\n[Select Project](command:azureDevOps.selectProject)"
      },
      {
        "view": "azureDevOps.pullRequests",
        "when": "azureDevOps.signedIn && !azureDevOps.hasProject",
        "contents": "Choose the project to work in.\n[Select Project](command:azureDevOps.selectProject)"
      },
      {
        "view": "azureDevOps.pipelines",
        "when": "azureDevOps.signedIn && !azureDevOps.hasProject",
        "contents": "Choose the project to work in.\n[Select Project](command:azureDevOps.selectProject)"
      },
      {
        "view": "azureDevOps.workItems",
        "when": "azureDevOps.signedIn && azureDevOps.hasProject && azureDevOps.denied.vso_work",
        "contents": "🔒 Work items are locked.\n\nYour Personal Access Token doesn't include the **Work Items (Read)** scope.\n[Edit PAT Scopes](command:azureDevOps.openTokenSettings)\n[Re-check Access](command:azureDevOps.recheckAccess)\nEdited the scopes of your existing token? Just re-check — the token value stays the same. You can also [use a different token](command:azureDevOps.updatePat) or [see everything your token can do](command:azureDevOps.showAccess)."
      },
      {
        "view": "azureDevOps.pullRequests",
        "when": "azureDevOps.signedIn && azureDevOps.hasProject && azureDevOps.denied.vso_code",
        "contents": "🔒 Pull requests are locked.\n\nYour Personal Access Token doesn't include the **Code (Read)** scope.\n[Edit PAT Scopes](command:azureDevOps.openTokenSettings)\n[Re-check Access](command:azureDevOps.recheckAccess)\nEdited the scopes of your existing token? Just re-check — the token value stays the same. You can also [use a different token](command:azureDevOps.updatePat) or [see everything your token can do](command:azureDevOps.showAccess)."
      },
      {
        "view": "azureDevOps.pipelines",
        "when": "azureDevOps.signedIn && azureDevOps.hasProject && azureDevOps.denied.vso_build",
        "contents": "🔒 Pipelines are locked.\n\nYour Personal Access Token doesn't include the **Build (Read)** scope.\n[Edit PAT Scopes](command:azureDevOps.openTokenSettings)\n[Re-check Access](command:azureDevOps.recheckAccess)\nEdited the scopes of your existing token? Just re-check — the token value stays the same. You can also [use a different token](command:azureDevOps.updatePat) or [see everything your token can do](command:azureDevOps.showAccess)."
      }
    ],
    "commands": [
      {
        "command": "azureDevOps.signIn",
        "title": "Sign In with Personal Access Token",
        "category": "Azure DevOps",
        "icon": "$(sign-in)"
      },
      {
