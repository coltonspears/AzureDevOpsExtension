    "menus": {
      "view/title": [
        {
          "command": "azureDevOps.showAccess",
          "when": "view == azureDevOps.account && azureDevOps.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.recheckAccess",
          "when": "view == azureDevOps.account && azureDevOps.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.switchOrganization",
          "when": "view == azureDevOps.account",
          "group": "1_org@1"
        },
        {
          "command": "azureDevOps.selectProject",
          "when": "view == azureDevOps.account && azureDevOps.signedIn",
          "group": "1_org@2"
        },
        {
          "command": "azureDevOps.selectTeam",
          "when": "view == azureDevOps.account && azureDevOps.hasProject",
          "group": "1_org@3"
        },
        {
          "command": "azureDevOps.updatePat",
          "when": "view == azureDevOps.account && azureDevOps.signedIn",
          "group": "2_pat@1"
        },
        {
          "command": "azureDevOps.openTokenSettings",
          "when": "view == azureDevOps.account && azureDevOps.signedIn",
          "group": "2_pat@2"
        },
        {
          "command": "azureDevOps.signOut",
          "when": "view == azureDevOps.account && azureDevOps.signedIn",
          "group": "3_session@1"
        },
        {
          "command": "azureDevOps.showLog",
          "when": "view == azureDevOps.account",
          "group": "4_diag@1"
        },
        {
          "command": "azureDevOps.workItems.create",
          "when": "view == azureDevOps.workItems && azureDevOps.hasProject && !azureDevOps.denied.vso_work_write",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.workItems.createLocked",
          "when": "view == azureDevOps.workItems && azureDevOps.hasProject && azureDevOps.denied.vso_work_write",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.workItems.search",
          "when": "view == azureDevOps.workItems && azureDevOps.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.workItems.refresh",
          "when": "view == azureDevOps.workItems && azureDevOps.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "azureDevOps.workItems.open",
          "when": "view == azureDevOps.workItems && azureDevOps.hasProject",
          "group": "1_open@1"
        },
        {
          "command": "azureDevOps.selectTeam",
          "when": "view == azureDevOps.workItems && azureDevOps.hasProject",
          "group": "2_scope@1"
        },
        {
          "command": "azureDevOps.selectProject",
          "when": "view == azureDevOps.workItems && azureDevOps.signedIn",
          "group": "2_scope@2"
        },
        {
          "command": "azureDevOps.pullRequests.create",
          "when": "view == azureDevOps.pullRequests && azureDevOps.hasProject && !azureDevOps.denied.vso_code_write",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.pullRequests.createLocked",
          "when": "view == azureDevOps.pullRequests && azureDevOps.hasProject && azureDevOps.denied.vso_code_write",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.pullRequests.open",
          "when": "view == azureDevOps.pullRequests && azureDevOps.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.pullRequests.refresh",
          "when": "view == azureDevOps.pullRequests && azureDevOps.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "azureDevOps.repos.clone",
          "when": "view == azureDevOps.pullRequests && azureDevOps.hasProject",
          "group": "1_repo@1"
        },
        {
          "command": "azureDevOps.selectProject",
          "when": "view == azureDevOps.pullRequests && azureDevOps.signedIn",
          "group": "2_scope@1"
        },
        {
          "command": "azureDevOps.pipelines.run",
          "when": "view == azureDevOps.pipelines && azureDevOps.hasProject && !azureDevOps.denied.vso_build_execute",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.pipelines.runLocked",
          "when": "view == azureDevOps.pipelines && azureDevOps.hasProject && azureDevOps.denied.vso_build_execute",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.pipelines.refresh",
          "when": "view == azureDevOps.pipelines && azureDevOps.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.selectProject",
          "when": "view == azureDevOps.pipelines && azureDevOps.signedIn",
          "group": "2_scope@1"
        }
      ],
      "view/item/context": [
        {
          "command": "azureDevOps.workItems.openInBrowser",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "inline@2"
        },
        {
          "command": "azureDevOps.workItems.changeState",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.workItems.open",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "1_open@1"
        },
        {
          "command": "azureDevOps.workItems.openInBrowser",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "1_open@2"
        },
        {
          "command": "azureDevOps.workItems.changeState",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "2_edit@1"
        },
        {
          "command": "azureDevOps.workItems.assignToMe",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "2_edit@2"
        },
        {
          "command": "azureDevOps.workItems.assign",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "2_edit@3"
        },
        {
          "command": "azureDevOps.workItems.addComment",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "2_edit@4"
        },
        {
          "command": "azureDevOps.workItems.createChild",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "2_edit@5"
        },
        {
          "command": "azureDevOps.workItems.createBranch",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "3_git@1"
        },
        {
          "command": "azureDevOps.workItems.copyLink",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "4_copy@1"
        },
        {
          "command": "azureDevOps.workItems.copyAsMarkdown",
          "when": "view == azureDevOps.workItems && viewItem == workItem",
          "group": "4_copy@2"
        },
        {
          "command": "azureDevOps.pullRequests.approve",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:active/",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pullRequests.openInBrowser",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:/",
          "group": "inline@2"
        },
        {
          "command": "azureDevOps.pullRequests.open",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:/",
          "group": "1_open@1"
        },
        {
          "command": "azureDevOps.pullRequests.openInBrowser",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:/",
          "group": "1_open@2"
        },
        {
          "command": "azureDevOps.pullRequests.checkout",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:/",
          "group": "2_git@1"
        },
        {
          "command": "azureDevOps.pullRequests.approve",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:active/",
          "group": "3_review@1"
        },
        {
          "command": "azureDevOps.pullRequests.vote",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:active/",
          "group": "3_review@2"
        },
        {
          "command": "azureDevOps.pullRequests.copyLink",
          "when": "view == azureDevOps.pullRequests && viewItem =~ /^pullRequest:/",
          "group": "4_copy@1"
        },
        {
          "command": "azureDevOps.pipelines.run",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineDefinition && !azureDevOps.denied.vso_build_execute",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pipelines.runLocked",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineDefinition && azureDevOps.denied.vso_build_execute",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineDefinition",
          "group": "inline@2"
        },
        {
          "command": "azureDevOps.pipelines.run",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineDefinition",
          "group": "1_run@1"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineDefinition",
          "group": "2_open@1"
        },
        {
          "command": "azureDevOps.pipelines.cancel",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:(inProgress|notStarted|postponed)/",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pipelines.retry",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:completed:(failed|partiallySucceeded|canceled)/",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:/",
          "group": "inline@2"
        },
        {
          "command": "azureDevOps.pipelines.rerun",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:/",
          "group": "1_run@1"
        },
        {
          "command": "azureDevOps.pipelines.run",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:/",
          "group": "1_run@2"
        },
        {
          "command": "azureDevOps.pipelines.retry",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:completed:(failed|partiallySucceeded|canceled)/",
          "group": "1_run@3"
        },
        {
          "command": "azureDevOps.pipelines.cancel",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:(inProgress|notStarted|postponed)/",
          "group": "1_run@4"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^pipelineRun:/",
          "group": "2_open@1"
        },
        {
          "command": "azureDevOps.pipelines.openLog",
          "when": "view == azureDevOps.pipelines && viewItem == timelineRecord:log",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pipelines.openLog",
          "when": "view == azureDevOps.pipelines && viewItem == timelineRecord:log",
          "group": "1_open@1"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem =~ /^timelineRecord/",
          "group": "1_open@2"
        },
        {
          "command": "azureDevOps.pipelines.approve",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineApproval",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.pipelines.reject",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineApproval",
          "group": "inline@2"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem == pipelineApproval",
          "group": "1_open@1"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "view == azureDevOps.pipelines && viewItem == release",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "azureDevOps.workItems.createFromSelection",
          "when": "azureDevOps.signedIn && editorHasSelection",
          "group": "9_azureDevOps@1"
        },
        {
          "command": "azureDevOps.repos.copyFileLink",
          "when": "azureDevOps.signedIn && resourceScheme == file",
          "group": "9_azureDevOps@2"
        },
        {
          "command": "azureDevOps.repos.openFileInBrowser",
          "when": "azureDevOps.signedIn && resourceScheme == file",
          "group": "9_azureDevOps@3"
        }
      ],
      "editor/title": [
        {
          "command": "azureDevOps.pullRequests.openFile",
          "when": "resourceScheme == azdo-git",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "azureDevOps.prComments.createThread",
          "when": "commentController == azureDevOps.pullRequestComments && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "azureDevOps.prComments.reply",
          "when": "commentController == azureDevOps.pullRequestComments && !commentThreadIsEmpty",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "azureDevOps.prComments.resolve",
          "when": "commentController == azureDevOps.pullRequestComments && commentThread == active",
          "group": "inline"
        },
        {
          "command": "azureDevOps.prComments.reactivate",
          "when": "commentController == azureDevOps.pullRequestComments && commentThread == resolved",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "azureDevOps.prComments.edit",
          "when": "commentController == azureDevOps.pullRequestComments && comment == own",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.prComments.delete",
          "when": "commentController == azureDevOps.pullRequestComments && comment == own",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "azureDevOps.prComments.cancelEdit",
          "when": "commentController == azureDevOps.pullRequestComments && comment == own",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.prComments.saveEdit",
          "when": "commentController == azureDevOps.pullRequestComments && comment == own",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "azureDevOps.explainScope",
